# Identity Risk Analyzer — configuration. Copy to `.env` (repo root or backend/) and adjust.
# Every value is optional: with no .env at all the app runs in offline mock mode.

# ---------------------------------------------------------------------------------------------
# Collector
# ---------------------------------------------------------------------------------------------
# mock     = bundled demo domain (backend/data/mock_ad.json), works fully offline
# ldap     = live, read-only collection from a domain controller (settings below)
# snapshot = replay a saved snapshot JSON (SNAPSHOT_PATH) — e.g. a real scan exported from the UI
SOURCE=mock
# MOCK_DATA_PATH=backend/data/mock_ad.json
# SNAPSHOT_PATH=./ira-snapshot-1a2b3c4d.json

# Seed 5 simulated earlier states of the demo domain on first start (mock mode, empty DB),
# so the trend chart and "since last scan" diff have history. Labelled "demo history" in the UI.
SEED_DEMO_HISTORY=true

# Override the "now" used for age thresholds (ISO-8601). Useful with a lab domain whose objects
# were created today: set a future date to make passwords/logons look old.
# ANALYSIS_DATE=2027-09-24T00:00:00+00:00

# ---------------------------------------------------------------------------------------------
# Live LDAP — READ-ONLY, LEAST PRIVILEGE
# The bind account needs only "Domain Users". Domain Admin is NOT required and NOT recommended.
# The tool never writes to AD (writes are blocked client-side) and never requests secrets.
# ---------------------------------------------------------------------------------------------
# LDAP_SERVER=dc01.corp.local
# LDAPS on 636 (recommended). For StartTLS on 389: LDAP_USE_SSL=false + LDAP_START_TLS=true
# LDAP_PORT=636
# LDAP_USE_SSL=true
# LDAP_START_TLS=false
# Validate the DC certificate against your internal CA (PEM). Never disable in production.
# LDAP_VALIDATE_CERT=true
# LDAP_CA_CERT=/etc/ssl/certs/corp-root-ca.pem
# SIMPLE (UPN over TLS, default) or NTLM (DOMAIN\user; needs `pip install pycryptodome` on OpenSSL 3)
# LDAP_AUTH=SIMPLE
# LDAP_BIND_USER=svc_ira_reader@corp.local
# Credentials are read from the environment only, kept as a secret in memory, never logged or stored.
# LDAP_BIND_PASSWORD=
# Auto-discovered from RootDSE (defaultNamingContext) when empty
# LDAP_BASE_DN=DC=corp,DC=local
# LDAP_TIMEOUT=15
# LDAP_PAGE_SIZE=500

# ---------------------------------------------------------------------------------------------
# Security event log (password spray / brute force / interactive service logons)
# Needs "Event Log Readers" on the DCs. Without logs these checks are skipped and the UI says so.
# ---------------------------------------------------------------------------------------------
# off      = disabled (default)
# file     = JSON produced by scripts/export_auth_events.ps1 (works from any OS)
# wevtutil = query the DC directly with `wevtutil /r:<DC>` (Windows host only)
EVENTLOG_MODE=off
# EVENTLOG_PATH=./auth_events.json
# EVENTLOG_DC=dc01.corp.local
# EVENTLOG_HOURS=24

# ---------------------------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------------------------
# DATABASE_URL=sqlite:///backend/data/risk_radar.db
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Periodic re-scan with APScheduler (0 = off)
SCHEDULE_INTERVAL_MINUTES=0
LOG_LEVEL=INFO
